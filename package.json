{
  "name": "route-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "graph": "node scripts/build-graph.mjs",
    "study:graph": "node scripts/build-study-graph.mjs",
    "study:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/check.ts",
    "study:run": "node --expose-gc --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/run.ts",
    "study:summarize": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/summarize.ts",
    "study:traces": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/traces.ts",
    "final:graph": "node scripts/study/final-graph.mjs",
    "final:run": "node --expose-gc --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/final-run.ts",
    "final:batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study/final-batch.ts",
    "test:study": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/study.test.ts",
    "test:final": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/final.test.ts",
    "test:final:results": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/final-results.test.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
